# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# gepa: local data, binaries, proprietary fonts
/data/
/bin/
/public/fonts/*.ttf
/public/fonts/*.TTF
/public/fonts/*.otf
/templates/*/reference.hwp
/.playwright-mcp/
/.omc/
/agent/.claude/settings.local.json
/.e2e-data/
/test-results/
/playwright-report/
/.next-e2e/
/.video-data/
/.next-video/
/video/
/agent/.omc/

# 정산보고서 참고본은 담당자가 실제로 낸 문서(개인정보·통장 사본 포함) — 저장소에 올리지 않는다
/templates/settlement/reference.hwpx

# 정산·결과보고 테스트 자료(기업·개인정보, 통장 사본) — 저장소에 올리지 않는다
/test_*/
