# Path to the locally installed Claude Code CLI (subscription login). No API keys are used anywhere.
CLAUDE_BIN=/Users/sangbumnam/.local/bin/claude
# Where projects, SQLite db and generated files live
DATA_DIR=./data
# rhwp CLI binary (installed by `pnpm setup:rhwp`)
RHWP_BIN=./bin/rhwp
# Model per stage (alias or model id, passed to `claude --model`). Defaults: research/plan=opus, notice/press/review=sonnet.
#GEPA_MODEL_RESEARCH=opus
#GEPA_MODEL_PLAN=opus
#GEPA_MODEL_NOTICE=sonnet
#GEPA_MODEL_PRESS=sonnet
#GEPA_MODEL_REVIEW=sonnet
# Fallback for every stage without a GEPA_MODEL_<STAGE>
#GEPA_MODEL=

# Public-data API keys for the research stage (read by the local MCP server only; never sent to the agent prompt).
# data.go.kr issues ONE key per account for every API you applied for — use the *Decoding* key.
#DATA_GO_KR_KEY=
# data.go.kr services this account has 활용신청 for (comma-separated ids; only listed ids are ever called).
# Catalog (lib/research/dataSources.ts, docs/research-data-sources.md §4):
#   15134343 관세청_시군구별 품목별 수출입실적   15101643 관세청_시도별 수출입실적(GW)   15101612 관세청_국가별 수출입실적(GW)
#   15101609 관세청_품목별 수출입실적(GW)       15100475 관세청_품목별 국가별 수출입실적(GW)
#   15095335 정책브리핑_정책뉴스_API            15012005 소진공_상가(상권)정보_API        15012894 전국전통시장표준데이터
#   15087611 산단공_공장등록생산정보조회         15034830 KOTRA_국가정보                   15122665 KOTRA_국가별 물가정보
#   15107303 행안부_지역별 주민등록인구          3038225  워크넷(고용24) 채용정보
#DATA_GO_KR_SERVICES=15134343,15101643,15101612,15095335,15012005,15012894,15087611,15034830,15107303
# KOSIS 공유서비스 (kosis.kr/openapi → 활용신청 → 인증키)
#KOSIS_KEY=
# 법제처 국가법령정보 공동활용 (open.law.go.kr) — the OC value is your registered e-mail id (the part before @)
#LAW_OC=
# 기업마당 지원사업정보 API (bizinfo.go.kr → 정책정보 개방)
#BIZINFO_KEY=

# Read-only snapshot of the institution's internal wiki for the research stage (optional). The
# .md files are copied into DATA_DIR/wiki (mode 0444) and mounted with --add-dir; the original is never mounted.
#GEPA_WIKI_DIR=/Users/sangbumnam/AI_Agents_git/GEPA_AI_Office/data/wiki
